# Salin ke .env lalu isi. Jangan commit .env.

# Google Sheets API key (Google Cloud Console → Credentials).
# Batasi key ini: HTTP referrer = domain web, API restriction = Google Sheets API saja.
VITE_GOOGLE_SHEETS_API_KEY=

# ID spreadsheet database-dashbooard-sembilan
VITE_SHEET_ID=1y0lOWfUMWpS27m7Zfk-d2BvM6I6AdU54EnEyf7Rza9s

# URL Web App dari apps-script/Code.gs (Deploy → Web app)
VITE_APPS_SCRIPT_URL=

# Uji lokal saja: true = pakai data contoh src/data/physicalMock.js untuk tab physical_test
VITE_USE_MOCK_PHYSICAL=false
